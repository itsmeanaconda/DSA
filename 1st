#include <iostream>
#include <cstdlib>
#include <algorithm>
using namespace std;

struct Student {
    int id;
    char name[50];
    float cgpa;
};

int main() {
    Student *s = NULL;
    int n = 0, choice, key;

    do {
        cout << "\n1. Add Student";
        cout << "\n2. Display Students";
        cout << "\n3. Linear Search";
        cout << "\n4. Binary Search";
        cout << "\n5. Exit";
        cout << "\nEnter choice: ";
        cin >> choice;

        switch(choice) {
        case 1:
            s = (Student*)realloc(s, (n+1)*sizeof(Student));

            if(s == NULL) {
                cout << "Memory allocation failed!";
                return 1;
            }

            cout << "Enter ID: ";
            cin >> s[n].id;

            cout << "Enter Name: ";
            cin >> s[n].name;

            cout << "Enter CGPA: ";
            cin >> s[n].cgpa;

            n++;
            cout << "Student added successfully!";
            break;

        case 2:
            for(int i=0; i<n; i++) {
                cout << "\nID: " << s[i].id;
                cout << "\nName: " << s[i].name;
                cout << "\nCGPA: " << s[i].cgpa << "\n";
            }
            break;

        case 3:
            cout << "Enter ID to search: ";
            cin >> key;

            {
                int found = 0;
                for(int i=0; i<n; i++) {
                    if(s[i].id == key) {
                        cout << "Student Found!";
                        cout << "\nName: " << s[i].name;
                        cout << "\nCGPA: " << s[i].cgpa;
                        found = 1;
                        break;
                    }
                }
                if(!found)
                    cout << "Student Not Found!";
            }
            break;

        case 4:
            sort(s, s+n, [](Student a, Student b) {
                return a.id < b.id;
            });

            cout << "Enter ID to search: ";
            cin >> key;

            {
                int low = 0, high = n-1, mid, found = 0;

                while(low <= high) {
                    mid = (low+high)/2;

                    if(s[mid].id == key) {
                        cout << "Student Found!";
                        cout << "\nName: " << s[mid].name;
                        cout << "\nCGPA: " << s[mid].cgpa;
                        found = 1;
                        break;
                    }
                    else if(s[mid].id < key)
                        low = mid+1;
                    else
                        high = mid-1;
                }

                if(!found)
                    cout << "Student Not Found!";
            }
            break;
        }
    } while(choice != 5);

    free(s);
    return 0;
}
